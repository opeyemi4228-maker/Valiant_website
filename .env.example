# Where form submissions (members, choirs, messages) are written as JSON lines.
# Defaults to ./data. Must be a writable, persistent directory.
FORMS_DATA_DIR=

# Optional: every submission is also POSTed here as JSON (Google Apps Script,
# Zapier, Make…). Required on hosts without a persistent disk, e.g. Vercel.
FORMS_WEBHOOK_URL=

# Required in production for NIN registration. NINs are stored only as a keyed
# fingerprint made with this secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once members have registered, or duplicate checks break.
NIN_HASH_SECRET=
